{
    "name": "keymeleon",
    "version": "0.0.1",
    "scripts": {
        "dev": "cross-env env=app browser=chrome test=true vite build --mode development",
        "prod": "cross-env env=app browser=chrome test=false vite build --mode production",
        "prod_test": "cross-env env=app browser=chrome test=true vite build --mode production",
        "prod_exit_build": "cross-env env=app browser=chrome test=false exit_build=true vite build --mode production",
        "fix": "oxfmt && oxlint --ignore-pattern **/*.scss --fix && tsc --noEmit",
        "format_cur": "oxfmt",
        "lint_cur": "oxlint --fix",
        "fix_cur": "powershell -File node_modules\\@loftyshaky\\shared-app\\build\\ps1\\fix_cur.ps1",
        "fix_scss": "oxfmt && stylelint --fix **/*.scss",
        "lint_cur_scss": "stylelint --fix",
        "fix_cur_scss": "powershell -File node_modules\\@loftyshaky\\shared-app\\build\\ps1\\fix_cur_scss.ps1",
        "build_all_prod": "powershell -File build\\ps1\\extension_build_all_prod.ps1",
        "pub": "powershell -File build\\ps1\\extension_pub.ps1"
    },
    "dependencies": {
        "@loftyshaky/shared-app": "2.2.0",
        "@simonwep/pickr": "^1.9.1",
        "lodash": "^4.18.1",
        "mobx": "^6.16.1",
        "mobx-react-lite": "^4.1.1",
        "mobx-utils": "^6.1.1",
        "normalize.css": "^8.0.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.0.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "app-root-path": "^3.1.0",
        "cross-env": "^10.1.0",
        "fs-extra": "^11.4.0",
        "is-empty-dir": "^2.0.0",
        "oxfmt": "^0.56.0",
        "oxlint": "^1.71.0",
        "oxlint-tsgolint": "^0.23.0",
        "rimraf": "^6.1.3",
        "sass-embedded": "^1.100.0",
        "stylelint": "^17.14.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.1.0",
        "vite-plugin-static-copy": "^4.1.1",
        "vite-plugin-svgr": "^5.2.0",
        "zip-a-folder": "^6.1.4"
    },
    "allowScripts": {
        "core-js@3.37.0": true,
        "@parcel/watcher@2.5.6": true
    }
}
